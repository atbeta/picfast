# Server
PICFAST_SERVER_PORT=8080
PICFAST_SERVER_BASE_URL=http://localhost:8080

# Database
PICFAST_DATABASE_URL=postgres://picfast:picfast@localhost:5432/picfast?sslmode=disable

# JWT
PICFAST_JWT_SECRET=change-me-in-production
PICFAST_JWT_ACCESS_TTL=15m
PICFAST_JWT_REFRESH_TTL=168h

# Storage
PICFAST_STORAGE_LOCAL_ROOT=./data/uploads
PICFAST_STORAGE_THUMBNAIL_DIR=./data/thumbnails

# App
PICFAST_APP_NAME=PicFast
PICFAST_APP_ALLOW_GUEST_UPLOAD=true
PICFAST_APP_ALLOW_REGISTRATION=true
PICFAST_APP_USER_INITIAL_CAPACITY=524288000

# Admin (set on first run to auto-create admin user)
PICFAST_APP_ADMIN_EMAIL=
PICFAST_APP_ADMIN_PASSWORD=

# Content moderation: disabled | manual | auto (future)
PICFAST_APP_MODERATION_MODE=disabled
