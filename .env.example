# Server
IMGAPI_SERVER_PORT=8080
IMGAPI_SERVER_BASE_URL=http://localhost:8080

# Database
IMGAPI_DATABASE_URL=postgres://imgapi:imgapi@localhost:5432/imgapi?sslmode=disable

# JWT
IMGAPI_JWT_SECRET=change-me-in-production
IMGAPI_JWT_ACCESS_TTL=15m
IMGAPI_JWT_REFRESH_TTL=168h

# Storage
IMGAPI_STORAGE_LOCAL_ROOT=./data/uploads
IMGAPI_STORAGE_THUMBNAIL_DIR=./data/thumbnails

# App
IMGAPI_APP_NAME=ImageAPI
IMGAPI_APP_ALLOW_GUEST_UPLOAD=true
IMGAPI_APP_ALLOW_REGISTRATION=true
IMGAPI_APP_USER_INITIAL_CAPACITY=524288000

# Admin (set on first run to auto-create admin user)
IMGAPI_APP_ADMIN_EMAIL=
IMGAPI_APP_ADMIN_PASSWORD=
