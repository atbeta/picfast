# Server
PICFAST_SERVER_PORT=8080
PICFAST_SERVER_METRICS_ADDR=127.0.0.1:9190
PICFAST_SERVER_BASE_URL=http://localhost:8080

# Database
PICFAST_DATABASE_URL=postgres://picfast:picfast@localhost:5432/picfast?sslmode=disable

# JWT
# 快速试用可以使用默认值；生产部署必须替换为强随机密钥。
PICFAST_JWT_SECRET=change-me-in-production
PICFAST_JWT_ACCESS_TTL=15m
PICFAST_JWT_REFRESH_TTL=168h

# Storage
PICFAST_STORAGE_LOCAL_ROOT=./data/uploads
PICFAST_STORAGE_THUMBNAIL_DIR=./data/thumbnails

# Mail
# 本地直接 `go run ./cmd/picfast` 时，Mailpit 走宿主机地址 127.0.0.1:1025。
# 若后端运行在 Docker 容器内，请改用 `mailpit`（见 docker/.env.dev.example）。
PICFAST_MAIL_HOST=127.0.0.1
PICFAST_MAIL_PORT=1025
PICFAST_MAIL_USERNAME=
PICFAST_MAIL_PASSWORD=
PICFAST_MAIL_FROM_EMAIL=noreply@picfast.local
PICFAST_MAIL_FROM_NAME=PicFast
PICFAST_MAIL_ENCRYPTION=none

# App
PICFAST_APP_NAME=PicFast
# 前端访问地址（如用于验证邮箱/重置密码）；留空则回退到 PICFAST_SERVER_BASE_URL。（可选）
PICFAST_APP_WEB_BASE_URL=
PICFAST_APP_ALLOW_GUEST_UPLOAD=false
PICFAST_APP_ALLOW_REGISTRATION=false
PICFAST_APP_REQUIRE_EMAIL_VERIFICATION=true
PICFAST_APP_USER_INITIAL_CAPACITY=524288000

# 管理员（可选无人值守初始化；留空则使用首次访问向导）
PICFAST_APP_ADMIN_EMAIL=
PICFAST_APP_ADMIN_PASSWORD=

# Content moderation: disabled | manual | auto (future)
PICFAST_APP_MODERATION_MODE=disabled

# Lower bound for generated image keys (range 4-10). Defaults to 4, which follows
# the historical tier table. Raise to 8 or 10 for visibly longer URLs and to
# effectively eliminate key collisions.
PICFAST_APP_IMAGE_KEY_MIN_LENGTH=4
