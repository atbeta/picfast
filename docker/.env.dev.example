# 本地开发环境变量参考。复制到仓库根目录 .env 后执行 make docker-up 即可。
# 所有变量均有默认值，不修改也能直接启动。

# --- PostgreSQL（db 服务）---
POSTGRES_USER=picfast
POSTGRES_PASSWORD=picfast
POSTGRES_DB=picfast

# --- JWT ---
PICFAST_JWT_SECRET=change-me-in-production

# --- 站点访问地址 ---
PICFAST_SERVER_BASE_URL=http://localhost:18080

# --- 无人值守创建管理员（留空则走浏览器初始化向导）---
PICFAST_APP_ADMIN_EMAIL=
PICFAST_APP_ADMIN_PASSWORD=

# --- 访问控制 ---
PICFAST_APP_ALLOW_GUEST_UPLOAD=false
PICFAST_APP_ALLOW_REGISTRATION=false
PICFAST_APP_REQUIRE_EMAIL_VERIFICATION=true

# --- 邮件（compose 内已启动 Mailpit，默认配置即可用）---
PICFAST_MAIL_HOST=mailpit
PICFAST_MAIL_PORT=1025
PICFAST_MAIL_USERNAME=
PICFAST_MAIL_PASSWORD=
PICFAST_MAIL_FROM_EMAIL=noreply@picfast.local
PICFAST_MAIL_FROM_NAME=PicFast
PICFAST_MAIL_ENCRYPTION=none
