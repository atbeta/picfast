# =============================================================================
# PicFast — docker-compose.traefik.yml 环境变量参考（Traefik / 生产向）
# =============================================================================
# 用法：在 docker 目录下
#   cp .env.traefik.example .env
#   docker compose -f docker-compose.traefik.yml up -d
#
# 请替换所有密码、域名与密钥；勿提交真实 .env。
# 文档：https://picfast.dev
# =============================================================================

# -----------------------------------------------------------------------------
# 通用
# -----------------------------------------------------------------------------
# 容器内时区（日志、定时任务等）。
TZ=Asia/Shanghai

# 拉取的 PicFast 镜像；固定版本可写 xbeta/picfast:v1.2.3
PICFAST_IMAGE=xbeta/picfast:latest

# -----------------------------------------------------------------------------
# 域名与公开访问 URL（必填核对）
# -----------------------------------------------------------------------------
# Traefik Host() 规则使用的域名，须与 DNS 指向一致。
PICFAST_DOMAIN=picfast.example.com

# PicFast 认为的「站点对外地址」，必须含 https（生产）。影响邮件链接、分享 URL、站点设置同步。
PICFAST_SERVER_BASE_URL=https://picfast.example.com

# Prometheus metrics 在应用容器内监听的地址。
# Compose 不会把这个端口发布到宿主机；Prometheus 应通过 Docker 网络抓取。
PICFAST_SERVER_METRICS_ADDR=:9190

# -----------------------------------------------------------------------------
# Traefik 接入
# -----------------------------------------------------------------------------
# 与外部 Traefik 容器共用的 Docker 网络名（compose 内 app.labels 会加入该网络）。
# 须与现有 Traefik 的 docker.network 配置一致。
TRAEFIK_DOCKER_NETWORK=traefik_monitoring

# -----------------------------------------------------------------------------
# PostgreSQL（db 服务，持久化在 ./data/postgres）
# -----------------------------------------------------------------------------
POSTGRES_DB=picfast
POSTGRES_USER=picfast
# 生产务必改为强密码；与任意备份策略一并考虑。
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# -----------------------------------------------------------------------------
# PicFast 核心安全
# -----------------------------------------------------------------------------
# JWT 签名密钥，生产必须替换。
PICFAST_JWT_SECRET=replace-with-a-strong-jwt-secret

# -----------------------------------------------------------------------------
# 站点元数据（启动时可注入；后续可在管理后台「站点设置」覆盖并入库）
# -----------------------------------------------------------------------------
PICFAST_APP_NAME=PicFast
PICFAST_APP_SITE_DESCRIPTION=Modern self-hosted image hosting for teams.

# 无人值守首批管理员：二者都设置则跳过浏览器初始化向导；留空则首次访问向导创建。
PICFAST_APP_ADMIN_EMAIL=
PICFAST_APP_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 功能开关
# -----------------------------------------------------------------------------
PICFAST_APP_ALLOW_GUEST_UPLOAD=false
PICFAST_APP_ALLOW_REGISTRATION=false
# 需配合下方 SMTP；未配邮件时「强制验证」不会真正生效。
PICFAST_APP_REQUIRE_EMAIL_VERIFICATION=true

# 审核：disabled | manual | auto（依版本支持为准）
PICFAST_APP_MODERATION_MODE=disabled

# 新用户默认配额（字节）。524288000 ≈ 500MiB
PICFAST_APP_USER_INITIAL_CAPACITY=524288000

# 图片默认生命周期：Go duration，0 表示不自动过期（由定时任务清理）。
PICFAST_APP_DEFAULT_IMAGE_TTL=0
# 游客图生命周期；0 表示沿用 default_image_ttl。
PICFAST_APP_GUEST_IMAGE_TTL=0

# -----------------------------------------------------------------------------
# 页脚与备案（可选，空行不展示）
# -----------------------------------------------------------------------------
PICFAST_APP_FOOTER_TEXT_1=
PICFAST_APP_FOOTER_LINK_1=
PICFAST_APP_FOOTER_TEXT_2=
PICFAST_APP_FOOTER_LINK_2=

# -----------------------------------------------------------------------------
# 统计脚本（可选）
# -----------------------------------------------------------------------------
# plausible | umami | ga4 | baidu | custom | 留空
PICFAST_APP_ANALYTICS_PROVIDER=
# JSON，结构与所选 provider 对应；strict CSP 时需配置 script-src。
PICFAST_APP_ANALYTICS_CONFIG={}

# -----------------------------------------------------------------------------
# SMTP（生产邮箱验证 / 找回密码等）
# -----------------------------------------------------------------------------
PICFAST_MAIL_HOST=
PICFAST_MAIL_PORT=587
PICFAST_MAIL_USERNAME=
PICFAST_MAIL_PASSWORD=
PICFAST_MAIL_FROM_EMAIL=
PICFAST_MAIL_FROM_NAME=PicFast
# none | starttls | tls
PICFAST_MAIL_ENCRYPTION=starttls
