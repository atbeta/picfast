TZ=Asia/Shanghai

PICFAST_IMAGE=xbeta/picfast:latest
PICFAST_DOMAIN=picfast.example.com
PICFAST_SERVER_BASE_URL=https://picfast.example.com
TRAEFIK_DOCKER_NETWORK=traefik_monitoring

POSTGRES_DB=picfast
POSTGRES_USER=picfast
POSTGRES_PASSWORD=replace-with-a-strong-db-password

PICFAST_JWT_SECRET=replace-with-a-strong-jwt-secret
PICFAST_APP_NAME=PicFast
PICFAST_APP_SITE_DESCRIPTION=Modern self-hosted image hosting for teams.
PICFAST_APP_ADMIN_EMAIL=admin@example.com
PICFAST_APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

PICFAST_APP_ALLOW_GUEST_UPLOAD=false
PICFAST_APP_ALLOW_REGISTRATION=false
PICFAST_APP_REQUIRE_EMAIL_VERIFICATION=true
PICFAST_APP_MODERATION_MODE=disabled
PICFAST_APP_USER_INITIAL_CAPACITY=524288000
PICFAST_APP_FOOTER_TEXT_1=
PICFAST_APP_FOOTER_LINK_1=
PICFAST_APP_FOOTER_TEXT_2=
PICFAST_APP_FOOTER_LINK_2=
PICFAST_APP_ANALYTICS_PROVIDER=
PICFAST_APP_ANALYTICS_CONFIG={}

# Optional mail settings for email verification / password reset
PICFAST_MAIL_HOST=
PICFAST_MAIL_PORT=587
PICFAST_MAIL_USERNAME=
PICFAST_MAIL_PASSWORD=
PICFAST_MAIL_FROM_EMAIL=
PICFAST_MAIL_FROM_NAME=PicFast
PICFAST_MAIL_ENCRYPTION=starttls
